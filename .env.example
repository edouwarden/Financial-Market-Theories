# Copy to .env and fill only the keys you need. Never commit .env.

# RapidAPI (Futuur, Polymarket, TradingView, weather, ...)
RAPIDAPI_KEY=

# PumpPortal account-trade subscription keys (comma-separated)
PUMPPORTAL_ACCOUNT_KEYS=

# ScrapingAnt proxy country for the Futuur depth probe
PROXY_COUNTRY=JP

# Optional private trader panel for theory 05 (gitignored)
TRADERS_FILE=

# YouTube Data API key for theory 13
YOUTUBE_API_KEY=
