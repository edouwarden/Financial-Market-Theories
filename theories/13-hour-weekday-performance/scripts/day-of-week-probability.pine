//@version=5
indicator("Average performance by day of week", overlay=false)

// Inputs
start_date = input.time(timestamp("2024-10-10"), title="Start date")
end_date = input.time(timestamp("2024-12-10"), title="End date")

// Variables to store performance by day.
var float[] monday_perf = array.new_float()
var float[] tuesday_perf = array.new_float()
var float[] wednesday_perf = array.new_float()
var float[] thursday_perf = array.new_float()
var float[] friday_perf = array.new_float()

// Add a performance to the appropriate array.
add_to_array_if_in_range(array<float> arr, float value, int day_of_week) =>
    if (dayofweek == day_of_week and time >= start_date and time <= end_date)
        array.push(arr, value)

// Fetch data with the security function.
daily_open = request.security(syminfo.tickerid, "D", open)
daily_close = request.security(syminfo.tickerid, "D", close)

// Compute the daily performance.
performance = daily_close - daily_open

// Add each performance to the matching array.
add_to_array_if_in_range(monday_perf, performance, dayofweek.monday)
add_to_array_if_in_range(tuesday_perf, performance, dayofweek.tuesday)
add_to_array_if_in_range(wednesday_perf, performance, dayofweek.wednesday)
add_to_array_if_in_range(thursday_perf, performance, dayofweek.thursday)
add_to_array_if_in_range(friday_perf, performance, dayofweek.friday)

// Compute the average of an array.
calculate_average(array<float> arr) =>
    array.size(arr) > 0 ? array.sum(arr) / array.size(arr) : na

// Compute the averages.
monday_avg = calculate_average(monday_perf)
tuesday_avg = calculate_average(tuesday_perf)
wednesday_avg = calculate_average(wednesday_perf)
thursday_avg = calculate_average(thursday_perf)
friday_avg = calculate_average(friday_perf)

// Display the results as a table.
var table perf_table = table.new(position.bottom_left, 2, 6, bgcolor=color.new(color.white, 90))
if (bar_index == 0)
    table.cell(perf_table, 0, 0, "Day", bgcolor=color.gray, text_color=color.white)
    table.cell(perf_table, 1, 0, "Average performance", bgcolor=color.gray, text_color=color.white)
    table.cell(perf_table, 0, 1, "Monday", bgcolor=color.black,text_color=color.white)
    table.cell(perf_table, 0, 2, "Tuesday", bgcolor=color.black, text_color=color.white)
    table.cell(perf_table, 0, 3, "Wednesday", bgcolor=color.black, text_color=color.white)
    table.cell(perf_table, 0, 4, "Thursday", bgcolor=color.black, text_color=color.white)
    table.cell(perf_table, 0, 5, "Friday", bgcolor=color.black, text_color=color.white)

// Update the table data.
table.cell(perf_table, 1, 1, str.tostring(monday_avg, "#.##")+ "%", bgcolor=color.black, text_color=color.white)
table.cell(perf_table, 1, 2, str.tostring(tuesday_avg, "#.##")+ "%", bgcolor=color.black, text_color=color.white)
table.cell(perf_table, 1, 3, str.tostring(wednesday_avg, "#.##")+ "%", bgcolor=color.black, text_color=color.white)
table.cell(perf_table, 1, 4, str.tostring(thursday_avg, "#.##")+ "%", bgcolor=color.black, text_color=color.white)
table.cell(perf_table, 1, 5, str.tostring(friday_avg, "#.##")+ "%", bgcolor=color.black, text_color=color.white)
