//@version=5
indicator("Price & OI Momentum", shorttitle="PriceOI-Mom", overlay=false, max_bars_back=500)

//===============================
// INPUTS
//===============================
len     = input.int(14, "Momentum Length", minval=1)

// Default area colors (modifiable)
price_col = input.color(color.new(#06d07e, 83), "Price Momentum Color")
oi_col    = input.color(color.new(#673ab7, 34), "OI Momentum Color")

src_grp = "Data Sources"
use_binance   = input.bool(true,  "Binance USDT.P_OI",  group=src_grp)
use_binance2  = input.bool(true,  "Binance USD.P_OI",   group=src_grp)
use_binance3  = input.bool(true,  "Binance BUSD.P_OI",  group=src_grp)
use_bitmex    = input.bool(true,  "BitMEX USD.P_OI",    group=src_grp)
use_bitmex2   = input.bool(true,  "BitMEX USDT.P_OI",   group=src_grp)
use_kraken    = input.bool(true,  "Kraken USD.P_OI",    group=src_grp)

//===============================
// AGGREGATED ABSOLUTE OI
//===============================
string mex = syminfo.basecurrency == "BTC" ? "XBT" : str.tostring(syminfo.basecurrency)

// Request only the OI close price from each source to avoid type issues
oi1 = request.security("BINANCE:" + str.tostring(syminfo.basecurrency) + "USDT.P_OI", timeframe.period, close, ignore_invalid_symbol=true)
oi2 = request.security("BINANCE:" + str.tostring(syminfo.basecurrency) + "USD.P_OI",  timeframe.period, close, ignore_invalid_symbol=true)
oi3 = request.security("BINANCE:" + str.tostring(syminfo.basecurrency) + "BUSD.P_OI", timeframe.period, close, ignore_invalid_symbol=true)
oi4 = request.security("BITMEX:"  + mex + "USD.P_OI",                    timeframe.period, close, ignore_invalid_symbol=true)
oi5 = request.security("BITMEX:"  + mex + "USDT.P_OI",                   timeframe.period, close, ignore_invalid_symbol=true)
oi6 = request.security("KRAKEN:"  + str.tostring(syminfo.basecurrency) + "USD.P_OI", timeframe.period, close, ignore_invalid_symbol=true)

OI_total = (use_binance   ? nz(oi1,0)            : 0) +
           (use_binance2  ? nz(oi2,0) / close     : 0) +
           (use_binance3  ? nz(oi3,0)             : 0) +
           (use_bitmex    ? nz(oi4,0) / close     : 0) +
           (use_bitmex2   ? nz(oi5,0) / close     : 0) +
           (use_kraken    ? nz(oi6,0) / close     : 0)

//===============================
// MOMENTUM CALCULATIONS
//===============================
price_mom = ta.roc(close,   len)
oi_mom    = ta.roc(OI_total, len)

//===============================
// PLOTS
//===============================
plot(price_mom, title="Price Momentum", style=plot.style_area, color=price_col)
plot(oi_mom,    title="OI Momentum",    style=plot.style_area, color=oi_col)

hline(0, "Zero", color=color.gray)
