// ============================================================================
// PLOT DES DONNÉES POUR DEBUG
// ============================================================================

// Plot de l'OI normalisé pour visualisation
//plot(oi_enable ? oi_normalized : na, "OI Normalisé", color=color.blue, linewidth=1)
//plot(oi_enable ? opacity_percent/100 : na, "Opacité", color=color.gray, linewidth=1)
