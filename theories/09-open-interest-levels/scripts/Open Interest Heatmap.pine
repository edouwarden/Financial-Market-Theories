// ============================================================================
// DATA PLOTS FOR DEBUG
// ============================================================================

// Plot normalized OI for visualization
//plot(oi_enable ? oi_normalized : na, "Normalized OI", color=color.blue, linewidth=1)
//plot(oi_enable ? opacity_percent/100 : na, "Opacity", color=color.gray, linewidth=1)
